@page
@model DeleteAllModel
@{
    ViewData["Title"] = "Delete all expenses";
}

<div class="page-head">
    <div>
        <h1>Delete all expenses</h1>
        <p class="sub">This removes every row in the database. There is no undo.</p>
    </div>
</div>

<div class="panel form-panel">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <span class="empty-emoji" aria-hidden="true">🫙</span>
            <p>There is nothing to delete — the list is already empty.</p>
            <a class="btn btn-ghost btn-sm" asp-page="./Index">Back to expenses</a>
        </div>
    }
    else
    {
        <div class="stat">
            <div class="stat-label">You are about to delete</div>
            <div class="stat-value">@Model.Count expense@(Model.Count == 1 ? "" : "s")</div>
            <div class="stat-note">Totalling @Currency.Format(Model.Total) across every month</div>
        </div>

        <p class="sub mt-4">
            Budgets are kept. Only expenses are removed, so the dashboard will show zero spending
            until you add something new.
        </p>

        <form method="post" class="form-actions">
            <button type="submit" class="btn btn-danger">Yes, delete all @Model.Count</button>
            <a class="btn btn-ghost" asp-page="./Index">Cancel</a>
        </form>
    }
</div>
